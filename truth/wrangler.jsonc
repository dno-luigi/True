{
  "name": "truth",
  "main": "src/worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2025-11-10",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "services": [
    {
      "binding": "JUSTICE",
      "service": "justice",
      "environment": "production"
    }
  ],
  "kv_namespaces": [
    {
      "id": "904eff3af4c14f06964e4f651cce9573",
      "binding": "MASTER_TRUTHS"
    },
    {
      "id": "4a9bfbffb4d440cba86badc508e2045a",
      "binding": "PROV_TRUTH"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "QC",
        "class_name": "QCLogger"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "TBACKED",
      "bucket_name": "ai-nspired"
    }
  ]
}